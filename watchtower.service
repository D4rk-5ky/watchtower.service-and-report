[Unit]
Description=Watchtower one-shot update and MQTT result report
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# Edit this to the directory containing the dedicated Watchtower Compose file.
WorkingDirectory=/opt/watchtower

# Pull the Watchtower image first. The leading '-' deliberately lets the main
# Compose run continue so ExecStartPost can still publish a failure result if
# pulling or starting ultimately fails.
ExecStartPre=-/usr/bin/docker compose -f docker-compose.yaml pull watchtower

# systemd owns the Watchtower lifecycle and waits for the one-shot container.
# The leading '-' is intentional: ExecStartPost must run for BOTH successful and
# unsuccessful Watchtower exits. ExecStartPost becomes the final success/failure gate.
ExecStart=-/usr/bin/docker compose -f docker-compose.yaml up --abort-on-container-exit --exit-code-from watchtower watchtower

# Read the completed container exit status and JSON logs, then publish exactly
# one MQTT JSON success/failure report. Change only the config filename to use
# the SMTP example instead of the sendmail example.
ExecStartPost=/usr/bin/python3 /opt/mqtt-power-action/mqtt_power_action_none.py -c /opt/mqtt-power-action/configs/config-sendmail-none.example.ini --watchtower-compose /opt/watchtower/docker-compose.yaml --watchtower-service watchtower

# Tear down this dedicated Compose project when the unit is stopped/restarted.
ExecStop=/usr/bin/docker compose -f docker-compose.yaml down

TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
